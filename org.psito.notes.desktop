[Desktop Entry]
Type=Application
Name=Psito Notes
GenericName=Sticky notes
GenericName[pt]=Notas autoadesivas
GenericName[es]=Notas adhesivas
GenericName[fr]=Notes autocollantes
GenericName[de]=Haftnotizen
GenericName[ru]=Заметки-стикеры
GenericName[zh]=便笺
Comment=Colourful notes that stay on your desktop
Comment[pt]=Notas coloridas que ficam na sua área de trabalho
Comment[es]=Notas de colores que se quedan en tu escritorio
Comment[fr]=Des notes colorées qui restent sur votre bureau
Comment[de]=Bunte Notizen, die auf deinem Schreibtisch bleiben
Comment[ru]=Цветные заметки, которые остаются на рабочем столе
Comment[zh]=留在桌面上的彩色便笺
Exec=psito_notes
Icon=org.psito.notes
Terminal=false
Categories=Utility;
Keywords=notes;sticky;stickies;memo;reminder;cockatiel;notas;lembrete;calopsita;
StartupWMClass=org.psito.notes
Actions=new-note;

[Desktop Action new-note]
Name=New note
Name[pt]=Nova nota
Name[es]=Nota nueva
Name[fr]=Nouvelle note
Name[de]=Neue Notiz
Name[ru]=Новая заметка
Name[zh]=新便笺
Exec=psito_notes --new
